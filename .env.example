# Power BI XMLA / REST API credentials
# Copy this file to .env and fill in your values

# Azure AD App Registration (no client secret required)
POWERBI_TENANT_ID=your-tenant-id-here
POWERBI_CLIENT_ID=your-client-id-here
POWERBI_USERNAME=your-email@cars24.com
POWERBI_PASSWORD=your-password-here

# Power BI Workspace & Dataset
POWERBI_XMLA_ENDPOINT=powerbi://api.powerbi.com/v1.0/myorg/Sell%20Analytics
POWERBI_DATASET_NAME=C2B GROWTH - REFERRAL
POWERBI_WORKSPACE_NAME=Sell Analytics
